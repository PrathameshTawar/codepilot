# CodePilot Environment Configuration
# Copy this file to .env and configure your local or provider settings

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Agent Execution Limits
MAX_RETRY_ATTEMPTS=3
DEFAULT_EXECUTION_TIMEOUT=30.0
MAX_OUTPUT_BYTES=150000

# Optional Model Inference (Local Ollama / Free-tier / Custom Endpoint)
MODEL_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5-coder:7b
